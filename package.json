{
  "name": "distopic-client",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop client for Distopic servers, with the official Discord one click away",
  "license": "MIT",
  "type": "module",
  "main": "out/main/index.js",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -p . && tsc -p packages/protocol",
    "sync:protocol": "node scripts/sync-protocol.mjs",
    "dist:win": "electron-vite build && electron-builder --win --x64 --publish never",
    "dist:linux": "electron-vite build && electron-builder --linux --publish never"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@distopic/protocol": "*",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "immer": "^11.0.0",
    "mediasoup-client": "^3.25.3",
    "pe-library": "^2.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resedit": "^3.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "allowScripts": {
    "electron@45.1.0": true,
    "esbuild@0.28.2": true
  },
  "productName": "Distopic",
  "author": "Gustavo Cruz",
  "homepage": "https://distopic.geg.dev.br",
  "repository": {
    "type": "git",
    "url": "https://github.com/GustavoHSCruz/distopic-client.git"
  },
  "build": {
    "appId": "br.dev.geg.distopic",
    "productName": "Distopic",
    "copyright": "Copyright \u00a9 2026 Gustavo Cruz",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "asar": true,
    "afterPack": "./build/after-pack.cjs",
    "publish": [
      {
        "provider": "github",
        "owner": "GustavoHSCruz",
        "repo": "distopic-client",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Distopic",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "Distopic-Setup-x64.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Network;Chat",
      "artifactName": "Distopic-${arch}.${ext}"
    }
  }
}
