{
  "name": "annoy-client",
  "version": "0.8.0",
  "private": true,
  "description": "Desktop client for Annoy servers, with the official Discord one click away",
  "license": "MIT",
  "type": "module",
  "main": "out/main/index.js",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -p . && tsc -p packages/protocol",
    "sync:protocol": "node scripts/sync-protocol.mjs",
    "dist:win": "electron-vite build && electron-builder --win --x64 --publish never",
    "dist:linux": "electron-vite build && electron-builder --linux --publish never",
    "test:activity": "node --experimental-strip-types --test scripts/tests/*-activity.test.mjs",
    "test:servers": "node --experimental-strip-types --test scripts/tests/server-removal.test.mjs",
    "test:connectivity": "node --experimental-strip-types --test scripts/tests/connectivity.test.mjs",
    "test:requests": "node --experimental-transform-types --test scripts/tests/requests.test.mjs",
    "test:voice": "node --experimental-strip-types --test scripts/tests/user-volume.test.mjs",
    "test:desktop": "npm run build && playwright test",
    "brand:icons": "node scripts/generate-icons.mjs",
    "electron:install": "node scripts/ensure-electron.mjs",
    "postinstall": "node scripts/ensure-electron.mjs",
    "predev": "node scripts/ensure-electron.mjs",
    "prestart": "node scripts/ensure-electron.mjs",
    "test:disconnect": "playwright test tests/disconnect.spec.ts"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "2.20.1",
    "@sapphi-red/web-noise-suppressor": "^0.4.1",
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@distopic/protocol": "*",
    "@playwright/test": "^1.64.1",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-menu": "2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "framer-motion": "^14.7.1",
    "immer": "^11.0.0",
    "lucide-react": "^1.63.0",
    "mediasoup-client": "^3.25.3",
    "monaco-editor": "0.57.0",
    "pe-library": "^2.0.1",
    "png-to-ico": "^3.0.2",
    "react": "^19.3.1",
    "react-colorful": "^5.8.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-easy-crop": "^6.2.4",
    "resedit": "^3.1.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "allowScripts": {
    "electron@45.1.0": true,
    "esbuild@0.28.2": true
  },
  "productName": "Annoy",
  "author": "Gustavo Cruz",
  "homepage": "https://annoy.geg.dev.br",
  "repository": {
    "type": "git",
    "url": "https://github.com/GeGLab/annoy-client.git"
  },
  "build": {
    "appId": "br.dev.geg.distopic",
    "productName": "Annoy",
    "copyright": "Copyright © 2026 Gustavo Cruz",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "asar": true,
    "afterPack": "./build/after-pack.cjs",
    "publish": [
      {
        "provider": "github",
        "owner": "GeGLab",
        "repo": "annoy-client",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Annoy",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "Annoy-Setup-x64.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Network;Chat",
      "artifactName": "Annoy-${arch}.${ext}"
    }
  },
  "overrides": {
    "@ghostery/adblocker": "2.20.1",
    "@ghostery/adblocker-electron-preload": "2.20.1"
  }
}
