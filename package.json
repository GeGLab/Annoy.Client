{
  "name": "distopic-client",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop client for Distopic servers, with the official Discord one click away",
  "license": "MIT",
  "type": "module",
  "main": "out/main/index.js",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -p . && tsc -p packages/protocol",
    "sync:protocol": "node scripts/sync-protocol.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@distopic/protocol": "*",
    "immer": "^11.0.0",
    "mediasoup-client": "^3.25.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.1.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "allowScripts": {
    "electron@45.1.0": true,
    "esbuild@0.28.2": true
  }
}
